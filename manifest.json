{
  "manifest_version": 3,
  "name": "Search Term Blocker",
  "version": "1.1.2",
  "description": "Blocks searches and URLs that match your configured rules.",
  "permissions": ["storage", "tabs", "webNavigation", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "service_worker.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "search-term-blocker@local.waqas",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "minimum_chrome_version": "111"
}
